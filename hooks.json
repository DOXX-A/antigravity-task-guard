{
  "terminal-task-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_run_command.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "schedule",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_schedule.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "manage_task",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_manage_task.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/stop_watchdog.py",
        "timeout": 5
      }
    ]
  }
}
